{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LINUP",
  "version": "0.1.0",
  "identifier": "io.linup.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "theme": "Light",
        "backgroundColor": "#FFFFFF",
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost https://openrouter.ai https://*.supabase.co https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["linup"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2NzlDNzc5OTU4OUM1QTkKUldTcHhZbVZlY2Q1eG52clR6QmNKZ2tGVzZtMXg0Q0YzUWpWQ3hjcmIzY2NYNVR3cUdmc1d3b1IK",
      "endpoints": ["https://linup.io/updates/{{target}}/{{arch}}/{{current_version}}"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
